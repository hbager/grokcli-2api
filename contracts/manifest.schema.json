{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grokcli-2api.local/contracts/manifest.schema.json",
  "title": "grokcli-2api compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle",
    "routes",
    "admin_routes",
    "authentication",
    "readiness",
    "data_safety",
    "stream_invariants",
    "failover",
    "nondeterministic_fields"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version"],
      "properties": {
        "implementation": {"const": "python"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "paths", "protocol", "go_phase"],
        "properties": {
          "method": {"enum": ["GET", "POST", "PATCH", "DELETE"]},
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^/"}
          },
          "protocol": {"type": "string", "minLength": 1},
          "go_phase": {"type": "string", "minLength": 1}
        }
      }
    },
    "admin_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write_except_registration", "registration_boundary"],
      "properties": {
        "read": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"}
        },
        "write_except_registration": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"}
        },
        "registration_boundary": {"type": "string", "minLength": 1}
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headers", "precedence"],
      "properties": {
        "headers": {"type": "array", "items": {"type": "string"}},
        "precedence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "fail_closed", "no_auto_migrate"],
      "properties": {
        "startup": {"type": "string", "minLength": 1},
        "fail_closed": {"type": "string", "minLength": 1},
        "no_auto_migrate": {"type": "string", "minLength": 1}
      }
    },
    "data_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durable_source",
        "redis_role",
        "forbidden_go_write_pattern",
        "required_write_pattern",
        "api_key_secret"
      ],
      "properties": {
        "durable_source": {"type": "string", "minLength": 1},
        "redis_role": {"type": "string", "minLength": 1},
        "forbidden_go_write_pattern": {"type": "string", "minLength": 1},
        "required_write_pattern": {"type": "string", "minLength": 1},
        "api_key_secret": {"type": "string", "minLength": 1}
      }
    },
    "stream_invariants": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1}
      }
    },
    "failover": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {"type": "string"},
        "forbidden": {"type": "string"}
      }
    },
    "nondeterministic_fields": {
      "type": "array",
      "items": {"type": "string", "pattern": "^\\$"}
    }
  }
}
